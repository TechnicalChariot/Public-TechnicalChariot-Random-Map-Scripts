/* Shooty_Gaia_Tower */
/* An Example by TechChariot */
/* 2026-07-30 */
/* Modified from Arabia Style Template, Shooting Gaia Tower in Map Center */
/* Licensed for Use in Any Age of Empires II Application */

<PLAYER_SETUP>
#const L 32 /* Defining Land Creation Command */
behavior_version 1
random_placement

/* Declaring Player Terrains */
#const PT1 6
#const PT2 6
#const PT3 6
#const PT4 6
#const PT5 6
#const PT6 6
#const PT7 6
#const PT8 6

/* Placeholder Definitions (No Seasonal Dependence) */
#const WPH1 97
#const WPH2 98
#const WNB  15
#const PHT1 34
#const PHT2 33
#const PHT3 38
#const PHT4 62
#const PHT5 39
#const PHT6 47

/* Remove Visual Effect of Dead Fish Trap */
#const ON_GRID 278
effect_amount GAIA_SET_ATTRIBUTE ON_GRID ATTR_STORAGE_VALUE 0

/* Configuring Building Blocker */
#const BLOCKER 1654
effect_percent GAIA_SET_ATTRIBUTE BLOCKER ATTR_RADIUS_1 50
effect_percent GAIA_SET_ATTRIBUTE BLOCKER ATTR_RADIUS_2 50
effect_percent GAIA_MOD_RESOURCE AMOUNT_BUILDING_TRICKLE_WOOD  ATTR_SET 0
effect_percent GAIA_MOD_RESOURCE AMOUNT_BUILDING_TRICKLE_FOOD  ATTR_SET 0
effect_percent GAIA_MOD_RESOURCE AMOUNT_BUILDING_TRICKLE_GOLD  ATTR_SET 0
effect_percent GAIA_MOD_RESOURCE AMOUNT_BUILDING_TRICKLE_STONE ATTR_SET 0

/* Disabling Trade for Low Resources */
if LOW_RESOURCES
  #const TRADE_CART_ENABLER 161
  #const TRADE_COG_ENABLER 180
  #const TRADE_CARAVAN_ENABLER 48
  #const HINDU_CARAVANSERAI_ENABLER 518
  #const PERSIAN_CARAVANSERAI_ENABLER 552  
  #const SILK_ROAD 499
  effect_amount DISABLE_TECH TRADE_COG_ENABLER ATTR_DISABLE 180
  effect_amount DISABLE_TECH TRADE_CART_ENABLER ATTR_DISABLE 161
  effect_amount DISABLE_TECH TRADE_CARAVAN_ENABLER ATTR_DISABLE 48
  effect_amount DISABLE_TECH HINDU_CARAVANSERAI_ENABLER ATTR_DISABLE 518
  effect_amount DISABLE_TECH PERSIAN_CARAVANSERAI_ENABLER ATTR_DISABLE 552
  effect_amount DISABLE_TECH SILK_ROAD ATTR_DISABLE 499    
else
endif

start_random
  percent_chance 50
  #define DESERT_MAP
end_random

if DESERT_MAP
  #const TREE0 351
else
  #const TREE0 349
endif

/* Initializing the Gaia Shooty Tower as an Archer of the Eyes */
#const SHOOTY_GAIA_TOWER 686
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_STANDING_GRAPHIC  301
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_STANDING2_GRAPHIC 301
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_DAMAGE_GRAPHIC 331
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_DYING_GRAPHIC 307
/* effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_DYING_GRAPHIC 12404 */

effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_ATTACK_GRAPHIC  301
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_ATTACK2_GRAPHIC 301
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_WALKING_GRAPHIC 301
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_RUNNING_GRAPHIC 301
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_SPECIAL_GRAPHIC 301

effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_NAME_ID 5567
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_ICON_ID 45

effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_TERRAIN_ID 0
effect_percent GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_RADIUS_1 100
effect_percent GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_RADIUS_2 100
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_DEAD_ID 143
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_HITPOINTS 2000
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_HERO_STATUS 4
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_PROJECTILE_ID 504
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_MIN_RANGE 0
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_MAX_RANGE 8
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_LINE_OF_SIGHT 16 
effect_amount  GAIA_SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_MOVE_SPEED 0

/* Initializing the Second Object, Visible Through Fog of War, as a Beach Rock */
/* This FOW Object must be inherently unconvertible, and also visible through the fog of war */
/* Its graphics are modified to match those of the original tower */
#const SGTFOW 1148
effect_amount  GAIA_SET_ATTRIBUTE SGTFOW ATTR_STANDING_GRAPHIC  301
effect_amount  GAIA_SET_ATTRIBUTE SGTFOW ATTR_STANDING2_GRAPHIC 301

/* Configuring Shooty Gaia Tower to Spawn Saboteur Upon Destruction */
effect_amount SET_ATTRIBUTE SHOOTY_GAIA_TOWER ATTR_BLOOD_ID 706

/* Configuring Saboteur Properties for Silent Explosion & to Assure Destruction of Special Object */
effect_amount UPGRADE_UNIT  SABOTEUR SILENT_EXPLOSION 0
effect_amount SET_ATTRIBUTE SABOTEUR ATTR_BLAST_RADIUS 1
effect_amount SET_ATTRIBUTE SABOTEUR ATTR_BLAST_LEVEL 0
effect_amount SET_ATTRIBUTE SABOTEUR ATTR_AREA_DAMAGE 100
effect_amount SET_ATTRIBUTE SABOTEUR ATTR_MAX_RANGE 2
effect_amount SET_ATTRIBUTE SABOTEUR ATTR_HITPOINTS 0
effect_amount SET_ATTRIBUTE SABOTEUR ATTR_STORAGE_VALUE 0

/* Configuring Additional Object for White Dot on Minimap */
#const SGTMM 685
effect_amount  GAIA_SET_ATTRIBUTE SGTMM ATTR_HITPOINTS 1
effect_amount  GAIA_SET_ATTRIBUTE SGTMM ATTR_RADIUS_1 0
effect_amount  GAIA_SET_ATTRIBUTE SGTMM ATTR_RADIUS_2 0
effect_amount  GAIA_SET_ATTRIBUTE SGTMM ATTR_STANDING_GRAPHIC  1751
effect_amount  GAIA_SET_ATTRIBUTE SGTMM ATTR_STANDING2_GRAPHIC 1751
effect_amount  GAIA_SET_ATTRIBUTE SGTMM ATTR_DYING_GRAPHIC 1751
effect_amount  GAIA_SET_ATTRIBUTE SGTMM ATTR_DEAD_ID 647


<ELEVATION_GENERATION>
create_elevation        7
{
  if DESERT_MAP
    base_terrain                     DIRT
  else           
    base_terrain                     GRASS3
  endif
  number_of_clumps 		20
  set_scale_by_groups
  if TINY_MAP 
    number_of_tiles 		6000
  elseif SMALL_MAP
    number_of_tiles 		9000
  elseif MEDIUM_MAP
    number_of_tiles 		12000
  elseif LARGE_MAP
    number_of_tiles 		17142
  elseif HUGE_MAP
    number_of_tiles 		20571
  else
    number_of_tiles 		24858
  endif
  enable_balanced_elevation           
}

<CLIFF_GENERATION>
  min_number_of_cliffs 15
  max_number_of_cliffs 20
  min_length_of_cliff  3
  max_length_of_cliff  5
<TERRAIN_GENERATION>
/* PRIMARY FOREST */
if DESERT_MAP
  create_terrain PALM_DESERT
  {
    base_terrain                   DIRT
    spacing_to_other_terrain_types 5
    land_percent                   12
    number_of_clumps               10
    set_avoid_player_start_areas     
    set_scale_by_groups
  }
else
  create_terrain FOREST
  {
    base_terrain                   GRASS3
    spacing_to_other_terrain_types 5
    land_percent                   12
    number_of_clumps               10
    set_avoid_player_start_areas     
    set_scale_by_groups
  }
endif

