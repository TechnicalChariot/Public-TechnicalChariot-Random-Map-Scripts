<LAND_GENERATION>

if DESERT_MAP
  base_terrain DIRT
  create_land { terrain_type DLC_DIRT4 land_position 50 50 base_size 5 number_of_tiles 200 base_elevation 7 land_id 1 }
else           
  base_terrain GRASS3
  create_land { terrain_type DIRT3     land_position 50 50 base_size 5 number_of_tiles 200 base_elevation 7 land_id 1 }
endif

create_player_lands 
{ 
if DESERT_MAP
  terrain_type DIRT
else           
  terrain_type GRASS3
endif
  land_percent     25
  base_size         9
  border_fuzziness 15
  circle_radius    30 3
}

/* LAND_AUTOSCRIBE */
